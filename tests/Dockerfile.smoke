# Espelho do Streamlit Cloud: Debian trixie, Python 3.13 e os pacotes do
# packages.txt instalados por apt. Prova que o LibreOffice do Debian lê CDR
# (libcdr) e que a suíte passa em Linux, com as fontes do sistema presentes —
# ambiente "mais limpo" que produção esconde defeito de fonte.
# Uso: docker build --load -f tests/Dockerfile.smoke -t cdr-odg-smoke . && docker run --rm cdr-odg-smoke
# trixie traz LibreOffice 25.2 / libcdr 0.1.8; no bookworm (LibreOffice 7.4) a
# libcdr antiga descarta parágrafos de texto com mais de um idioma, o que NÃO
# acontece em produção.
FROM python:3.13-slim-trixie
WORKDIR /app
COPY packages.txt .
RUN apt-get update \
 && xargs -a packages.txt apt-get install -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest
COPY . .
RUN soffice --version
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
